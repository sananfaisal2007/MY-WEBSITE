<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Welcome 🌌 | Sanan's World</title>

<style>
/* ═══════════════════════════════════════
   🌌 SOLAR SYSTEM WELCOME — CSS
   ═══════════════════════════════════════ */

#welcome-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    overflow: hidden;
    background: #050314;
    color: #fff;
    font-family: 'Poppins', 'Arial', sans-serif;
}

/* ─── SPACE BACKGROUND ─── */
#space {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(ellipse at 50% 50%, rgba(60, 20, 100, 0.4), transparent 60%),
        radial-gradient(ellipse at 20% 80%, rgba(100, 40, 140, 0.3), transparent 50%),
        radial-gradient(ellipse at 80% 20%, rgba(40, 60, 140, 0.3), transparent 50%),
        linear-gradient(180deg, #050314 0%, #0a0520 40%, #050314 100%);
    overflow: hidden;
}

#space::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 30% 40%, rgba(200, 130, 255, 0.15), transparent 30%),
        radial-gradient(circle at 70% 60%, rgba(255, 130, 200, 0.12), transparent 30%),
        radial-gradient(circle at 50% 80%, rgba(130, 200, 255, 0.1), transparent 35%);
    filter: blur(40px);
}

#space::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        120deg,
        transparent 20%,
        rgba(200, 180, 255, 0.28) 40%,
        rgba(255, 200, 240, 0.42) 50%,
        rgba(200, 180, 255, 0.28) 60%,
        transparent 80%
    );
    filter: blur(18px);
    pointer-events: none;
}

/* ─── ASTEROIDS ─── */
#asteroidsLayer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    overflow: hidden;
}

.asteroid {
    position: absolute;
    background: radial-gradient(circle at 35% 35%,
        #9a8a78,
        #6a5a48 50%,
        #3a2a18 100%);
    border-radius: 45% 55% 60% 40% / 55% 45% 55% 45%;
    box-shadow:
        inset -2px -2px 5px rgba(0, 0, 0, 0.7),
        inset 2px 2px 4px rgba(180, 160, 130, 0.3),
        0 0 8px rgba(140, 120, 90, 0.4);
    animation: asteroidDrift linear infinite;
    will-change: transform;
}

.asteroid::before {
    content: "";
    position: absolute;
    top: 25%;
    left: 20%;
    width: 25%;
    height: 25%;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    filter: blur(1px);
}

.asteroid::after {
    content: "";
    position: absolute;
    top: 55%;
    left: 60%;
    width: 15%;
    height: 15%;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
    filter: blur(1px);
}

@keyframes asteroidDrift {
    0% {
        transform: translate(0, 0) rotate(0deg);
    }
    100% {
        transform: translate(var(--ax), var(--ay)) rotate(720deg);
    }
}

@media (prefers-reduced-motion: reduce) {
    .asteroid {
        animation: none;
    }
}

/* ─── STARS ─── */
.solar-star {
    position: absolute;
    border-radius: 50%;
    background: #fff;
    pointer-events: none;
    animation: starTwinkle ease-in-out infinite;
}

.solar-star.small  { width: 1px; height: 1px; box-shadow: 0 0 4px #fff; }
.solar-star.medium { width: 2px; height: 2px; box-shadow: 0 0 6px #fff, 0 0 12px rgba(200, 180, 255, 0.5); }
.solar-star.big    { width: 3px; height: 3px; box-shadow: 0 0 8px #fff, 0 0 16px rgba(255, 200, 240, 0.6); }

.solar-star.purple { background: #c9a6ff; }
.solar-star.pink   { background: #ffc8f2; }
.solar-star.gold   { background: #ffe27a; }
.solar-star.cyan   { background: #a5f3fc; }

@keyframes starTwinkle {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50%      { opacity: 1; transform: scale(1.2); }
}

/* ─── SUN ─── */
#sunWrap {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    pointer-events: none;
}

#sunGlow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 400px;
    height: 400px;
    margin: -200px 0 0 -200px;
    border-radius: 50%;
    background: radial-gradient(circle,
        rgba(255, 220, 100, 0.6) 0%,
        rgba(255, 180, 80, 0.35) 30%,
        rgba(255, 140, 60, 0.15) 55%,
        transparent 75%);
    filter: blur(20px);
    animation: sunPulse 4s ease-in-out infinite;
}

@keyframes sunPulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50%      { transform: scale(1.1); opacity: 1; }
}

#sun {
    position: relative;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%,
        #fff8c0 0%,
        #ffe27a 25%,
        #ffb84d 60%,
        #ff8a1a 100%);
    box-shadow:
        0 0 40px #ffe27a,
        0 0 80px rgba(255, 180, 80, 0.7),
        0 0 120px rgba(255, 140, 60, 0.5),
        inset 0 0 30px rgba(255, 255, 255, 0.5);
    animation: sunFloat 6s ease-in-out infinite;
}

@keyframes sunFloat {
    0%, 100% { transform: translateY(0) scale(1); }
    50%      { transform: translateY(-6px) scale(1.02); }
}

.sun-eye {
    position: absolute;
    width: 16px;
    height: 20px;
    background: #3a2010;
    border-radius: 50%;
    top: 54px;
    animation: sunBlink 4s ease-in-out infinite;
}

.sun-eye.left  { left: 42px; }
.sun-eye.right { right: 42px; animation-delay: 0.1s; }

.sun-eye::before {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    background: #fff;
    border-radius: 50%;
    top: 4px;
    left: 4px;
}

@keyframes sunBlink {
    0%, 42%, 58%, 100% { transform: scaleY(1); }
    50%                { transform: scaleY(0.1); }
}

.sun-mouth {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    width: 36px;
    height: 18px;
    border: 3px solid #3a2010;
    border-top: none;
    border-radius: 0 0 40px 40px;
}

.sun-blush {
    position: absolute;
    width: 18px;
    height: 10px;
    background: rgba(255, 120, 100, 0.5);
    border-radius: 50%;
    top: 80px;
    filter: blur(3px);
}
.sun-blush.left  { left: 22px; }
.sun-blush.right { right: 22px; }

/* ─── PLANETS ─── */
#solarSystem {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    z-index: 4;
    pointer-events: none;
}

.orbit-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border: 1px solid rgba(200, 180, 255, 0.1);
    transform: translate(-50%, -50%);
    pointer-events: none;
}

.planet-orbit {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50%;
    animation: orbit linear infinite;
}

@keyframes orbit {
    to { transform: rotate(360deg); }
}

.planet {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: auto;
    cursor: pointer;
    transition: filter 0.3s ease, transform 0.3s ease;
}

.planet:hover {
    filter: brightness(1.4);
    transform: translate(-50%, -50%) scale(1.25);
}

.planet-eye {
    position: absolute;
    width: 15%;
    height: 20%;
    background: #1a1030;
    border-radius: 50%;
    top: 40%;
    animation: planetBlink 5s ease-in-out infinite;
}

.planet-eye.left  { left: 25%; }
.planet-eye.right { right: 25%; animation-delay: 0.1s; }

.planet-eye::before {
    content: "";
    position: absolute;
    width: 40%;
    height: 40%;
    background: #fff;
    border-radius: 50%;
    top: 15%;
    left: 15%;
}

@keyframes planetBlink {
    0%, 45%, 55%, 100% { transform: scaleY(1); }
    50%                { transform: scaleY(0.1); }
}

.planet-smile {
    position: absolute;
    bottom: 22%;
    left: 50%;
    transform: translateX(-50%);
    width: 22%;
    height: 8%;
    border: 2px solid #1a1030;
    border-top: none;
    border-radius: 0 0 40px 40px;
    opacity: 0.9;
}

.saturn-rings {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 200%;
    height: 40%;
    border: 3px solid rgba(255, 220, 150, 0.7);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-15deg);
    box-shadow:
        0 0 8px rgba(255, 220, 150, 0.6),
        inset 0 0 8px rgba(255, 220, 150, 0.4);
    pointer-events: none;
}

/* ─── CENTER UI ─── */
#uiBox {
    position: absolute;
    left: 50%;
    top: 72%;
    transform: translate(-50%, -50%);
    z-index: 10;
    text-align: center;
    pointer-events: none;
    width: 90%;
    max-width: 440px;
}

#uiBox .ui-label {
    display: block;
    font-size: 10px;
    letter-spacing: 5px;
    color: #ffe27a;
    font-weight: 800;
    margin-bottom: 12px;
    text-shadow: 0 0 12px rgba(255, 226, 122, 0.6);
    animation: labelPulse 3s ease-in-out infinite;
}

@keyframes labelPulse {
    0%, 100% { opacity: 0.8; }
    50%      { opacity: 1; }
}

#uiBox .ui-title {
    font-size: clamp(20px, 3.5vw, 32px);
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 1.2;
    background: linear-gradient(135deg, #ffffff, #ffc8f2, #c9a6ff, #ffe27a, #ffffff);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 10px;
    animation: titleFlow 5s linear infinite;
    filter: drop-shadow(0 0 20px rgba(200, 130, 255, 0.4));
}

@keyframes titleFlow {
    to { background-position: 300% 0; }
}

#uiBox .ui-subtitle {
    font-size: 12px;
    color: #c8b8e0;
    line-height: 1.6;
    margin-bottom: 16px;
    font-weight: 500;
}

/* ─── NAME INPUT ─── */
.wd-name-wrap {
    position: relative;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    padding: 2px;
    border-radius: 50px;
    background: linear-gradient(90deg, #8b4dff, #ffc8f2, #ffe27a, #8b4dff);
    background-size: 300% 100%;
    animation: borderFlow 5s linear infinite;
    box-shadow:
        0 0 20px rgba(200, 130, 255, 0.5),
        0 0 40px rgba(255, 200, 242, 0.3);
    pointer-events: auto;
}

@keyframes borderFlow {
    to { background-position: 300% 0; }
}

#visitorName {
    display: block;
    width: 100%;
    padding: 12px 18px;
    border: none;
    outline: none;
    border-radius: 47px;
    background: rgba(15, 8, 30, 0.95);
    color: #fff;
    font-size: 14px;
    font-family: inherit;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-align: center;
    text-shadow: 0 0 10px rgba(255, 200, 242, 0.6);
    caret-color: #ffc8f2;
}

#visitorName::placeholder {
    color: #8a7aa8;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.wd-name-wrap.typing {
    animation: inputGlow 0.6s ease-out;
}

@keyframes inputGlow {
    0% { box-shadow: 0 0 20px rgba(139, 77, 255, 0.3); }
    50% { box-shadow: 0 0 40px rgba(255, 200, 242, 0.9), 0 0 80px rgba(200, 130, 255, 0.6); }
    100% { box-shadow: 0 0 20px rgba(139, 77, 255, 0.3); }
}

.wd-name-wrap.shake-letter {
    animation: letterShake 0.2s ease-out;
}

@keyframes letterShake {
    0%, 100% { transform: translateX(0); }
    25%      { transform: translateX(-2px); }
    75%      { transform: translateX(2px); }
}

/* ─── SUN BUBBLE ─── */
#sunBubble {
    position: absolute;
    left: 50%;
    top: calc(50% - 200px);
    transform: translate(-50%, -100%);
    background: linear-gradient(135deg, #fff8c0, #ffe27a);
    color: #4a2010;
    padding: 12px 22px;
    border-radius: 20px 20px 20px 4px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
    max-width: 320px;
    text-align: center;
    box-shadow: 0 8px 30px rgba(255, 200, 100, 0.5);
    z-index: 20;
    pointer-events: none;
    animation: bubbleFloat 3s ease-in-out infinite;
}

#sunBubble::after {
    content: "";
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 12px solid transparent;
    border-right: 12px solid transparent;
    border-top: 14px solid #ffe27a;
}

@keyframes bubbleFloat {
    0%, 100% { transform: translate(-50%, -100%); }
    50%      { transform: translate(-50%, calc(-100% - 6px)); }
}

/* ─── ENTER BUTTON ─── */
#enterBtn {
    position: absolute;
    left: 50%;
    bottom: 50px;
    transform: translateX(-50%);
    z-index: 15;
    padding: 14px 36px;
    border: 2px solid #ffe27a;
    border-radius: 50px;
    background: linear-gradient(135deg,
        rgba(255, 226, 122, 0.2),
        rgba(255, 200, 242, 0.15),
        rgba(200, 130, 255, 0.2));
    color: #fff;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 3px;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow:
        0 0 30px rgba(255, 226, 122, 0.5),
        0 0 60px rgba(200, 130, 255, 0.3),
        inset 0 0 20px rgba(255, 255, 255, 0.1);
    animation: btnPulse 3s ease-in-out infinite;
}

@keyframes btnPulse {
    0%, 100% {
        box-shadow:
            0 0 30px rgba(255, 226, 122, 0.5),
            0 0 60px rgba(200, 130, 255, 0.3),
            inset 0 0 20px rgba(255, 255, 255, 0.1);
    }
    50% {
        box-shadow:
            0 0 50px rgba(255, 226, 122, 0.8),
            0 0 100px rgba(200, 130, 255, 0.5),
            inset 0 0 30px rgba(255, 255, 255, 0.2);
    }
}

#enterBtn:hover {
    background: linear-gradient(135deg,
        rgba(255, 226, 122, 0.4),
        rgba(255, 200, 242, 0.3),
        rgba(200, 130, 255, 0.4));
    transform: translateX(-50%) translateY(-3px) scale(1.05);
}

/* ─── LIVE NAME DISPLAY ─── */
#liveNameDisplay {
    position: fixed;
    left: 50%;
    top: 45%;
    transform: translate(-50%, -50%);
    z-index: 100000;
    pointer-events: none;
    font-size: clamp(40px, 10vw, 100px);
    font-weight: 900;
    letter-spacing: 4px;
    text-align: center;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
    white-space: nowrap;
}

#liveNameDisplay.visible {
    opacity: 1;
}

.live-letter {
    display: inline-block;
    background: linear-gradient(135deg, #ffffff, #ffc8f2, #c9a6ff, #ffe27a, #ffffff);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
        letterDrop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
        letterFlow 3s linear infinite;
    filter: drop-shadow(0 0 20px rgba(255, 200, 242, 0.6))
            drop-shadow(0 0 40px rgba(200, 130, 255, 0.3));
}

@keyframes letterDrop {
    0% { opacity: 0; transform: translateY(-60px) scale(0.3) rotate(-25deg); }
    60% { opacity: 1; transform: translateY(8px) scale(1.15) rotate(5deg); }
    100% { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); }
}

@keyframes letterFlow {
    to { background-position: 300% 0; }
}

/* ─── SPARKLE CANVAS ─── */
#typeSparkleCanvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 99999;
}

.type-particle {
    position: fixed;
    pointer-events: none;
    z-index: 100001;
    font-size: 20px;
    animation: typeParticleFly 1.2s ease-out forwards;
}

@keyframes typeParticleFly {
    0% { opacity: 1; transform: translate(0, 0) scale(1) rotate(0deg); }
    100% { opacity: 0; transform: translate(var(--tx), var(--ty)) scale(0.3) rotate(360deg); }
}

.type-flash {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 99998;
    background: radial-gradient(circle at center,
        rgba(255, 200, 242, 0.15),
        rgba(200, 130, 255, 0.08),
        transparent 70%);
    animation: typeFlash 0.4s ease-out forwards;
}

@keyframes typeFlash {
    0% { opacity: 0; }
    30% { opacity: 1; }
    100% { opacity: 0; }
}

/* ─── MOBILE ─── */
@media (max-width: 700px) {
    #sun { width: 100px; height: 100px; }
    .sun-eye { width: 12px; height: 16px; top: 38px; }
    .sun-eye.left  { left: 28px; }
    .sun-eye.right { right: 28px; }
    .sun-mouth { bottom: 26px; width: 26px; height: 14px; }
    .sun-blush { width: 14px; height: 8px; top: 58px; }
    .sun-blush.left  { left: 14px; }
    .sun-blush.right { right: 14px; }
    #sunGlow { width: 280px; height: 280px; margin: -140px 0 0 -140px; }

    #sunBubble {
        top: calc(50% - 150px);
        font-size: 11px;
        padding: 10px 16px;
        max-width: 240px;
    }

    #enterBtn {
        bottom: 30px;
        padding: 12px 26px;
        font-size: 12px;
        letter-spacing: 2px;
    }

    #uiBox .ui-title { font-size: 20px; }
    #uiBox .ui-subtitle { font-size: 11px; }
    #uiBox .ui-label { font-size: 9px; letter-spacing: 3px; }

    .wd-name-wrap { max-width: 260px; }
    #visitorName { padding: 10px 14px; font-size: 13px; }

    #liveNameDisplay {
        font-size: clamp(32px, 12vw, 64px);
        letter-spacing: 2px;
    }
}

/* ─── REDUCED MOTION ─── */
@media (prefers-reduced-motion: reduce) {
    #space::before,
    #space::after,
    #sunGlow,
    #sun,
    .solar-star,
    .sun-eye,
    .planet-eye,
    #sunBubble,
    #enterBtn,
    .live-letter,
    .wd-name-wrap,
    #uiBox .ui-label,
    #uiBox .ui-title {
        animation: none !important;
    }
}
</style>

</head>
<body>

<!-- ═══════════════════════════════════════
     🌌 SOLAR SYSTEM WELCOME SCREEN
     ═══════════════════════════════════════ -->
<div id="welcome-screen">

    <!-- Space background -->
    <div id="space" aria-hidden="true"></div>

    <!-- Sun (center) -->
    <div id="sunWrap" aria-hidden="true">
        <div id="sunGlow"></div>
        <div id="sun">
            <div class="sun-eye left"></div>
            <div class="sun-eye right"></div>
            <div class="sun-mouth"></div>
            <div class="sun-blush left"></div>
            <div class="sun-blush right"></div>
        </div>
    </div>

    <!-- Solar System (planets) -->
    <div id="solarSystem" aria-hidden="true"></div>

    <!-- Center UI -->
    <div id="uiBox">
        <span class="ui-label">✦ WELCOME TO MY COSMOS ✦</span>
        <h1 class="ui-title">A Little World Called Mine</h1>
        <p class="ui-subtitle">
            Apna naam batao, traveler — sitare tumhara intezar kar rahe hain.
        </p>

        <div class="wd-name-wrap" id="nameWrap">
            <input id="visitorName" type="text" maxlength="30"
                   autocomplete="off" spellcheck="false"
                   placeholder="✨ Apna naam likho...">
        </div>
    </div>

    <!-- Sun bubble -->
    <div id="sunBubble">
        ✨ Ruk jao traveler! Pehle apna naam batao — phir hum sab tumhe apni duniya ghumayenge! 🌞
    </div>

    <!-- Enter button -->
    <button id="enterBtn" type="button">ENTER MY WORLD ✨</button>

    <!-- Live name display (magic typing) -->
    <div id="liveNameDisplay" aria-hidden="true"></div>

    <!-- Sparkle canvas -->
    <canvas id="typeSparkleCanvas" aria-hidden="true"></canvas>
</div>

<script>
(function () {
    "use strict";

    /* ═══════════════════════════════════════
       🌌 SOLAR SYSTEM WELCOME — SCRIPT
       ═══════════════════════════════════════ */

    /* ─── STARFIELD ─── */
    var space = document.getElementById("space");
    if (!space) return;

    var starColors = ["", "purple", "pink", "gold", "cyan"];
    var starSizes = ["small", "small", "small", "medium", "big"];

    for (var i = 0; i < 220; i++) {
        var s = document.createElement("div");
        s.className = "solar-star " + starSizes[Math.floor(Math.random() * starSizes.length)];
        var c = starColors[Math.floor(Math.random() * starColors.length)];
        if (c) s.classList.add(c);
        s.style.left = Math.random() * 100 + "%";
        s.style.top = Math.random() * 100 + "%";
        s.style.animationDelay = (-Math.random() * 4) + "s";
        s.style.animationDuration = (2 + Math.random() * 4) + "s";
        space.appendChild(s);
    }

    /* ─── ASTEROIDS ─── */
    var asteroidsLayer = document.createElement("div");
    asteroidsLayer.id = "asteroidsLayer";
    document.getElementById("welcome-screen").appendChild(asteroidsLayer);

    var asteroidsCount = window.innerWidth < 700 ? 25 : 50;

    for (var ai = 0; ai < asteroidsCount; ai++) {
        (function (idx) {
            var a = document.createElement("div");
            a.className = "asteroid";

            var size = 4 + Math.random() * 14;
            a.style.width = size + "px";
            a.style.height = size + "px";
            a.style.left = Math.random() * 100 + "%";
            a.style.top = Math.random() * 100 + "%";
            a.style.opacity = (0.35 + Math.random() * 0.5).toFixed(2);

            var angle = Math.random() * Math.PI * 2;
            var distance = 100 + Math.random() * 300;
            var ax = Math.cos(angle) * distance;
            var ay = Math.sin(angle) * distance;

            a.style.setProperty("--ax", ax + "px");
            a.style.setProperty("--ay", ay + "px");

            a.style.animationDuration = (25 + Math.random() * 40) + "s";
            a.style.animationDelay = (-Math.random() * 30) + "s";

            asteroidsLayer.appendChild(a);
        })(ai);
    }

    /* ─── PLANETS ─── */
    var planetsData = [
        { name: "Mercury", size: 8,  color: "#b8a890", orbit: 80,  speed: 18, hasRing: false, line: "Main chhota hoon, lekin tez bhagta hoon! 🪨" },
        { name: "Venus",   size: 12, color: "#ffd18a", orbit: 110, speed: 22, hasRing: false, line: "Main sab se chamakta hoon... literally! 💛" },
        { name: "Earth",   size: 13, color: "#4a9eff", orbit: 140, speed: 26, hasRing: false, line: "Main ghar hoon sabka — Earth, yaad rakho! 🏡" },
        { name: "Mars",    size: 11, color: "#e85a4a", orbit: 170, speed: 30, hasRing: false, line: "Red Planet? Red attitude bhi 😎" },
        { name: "Jupiter", size: 24, color: "#d4a574", orbit: 210, speed: 36, hasRing: false, line: "Sab se bara hoon, sab se pyaara hoon 😌" },
        { name: "Saturn",  size: 20, color: "#e8d4a0", orbit: 255, speed: 42, hasRing: true,  line: "Rings meri pehchaan hain 💍✨" },
        { name: "Uranus",  size: 16, color: "#8ad4e8", orbit: 300, speed: 48, hasRing: false, line: "Main thanda hoon, lekin cool hoon 💠" },
        { name: "Neptune", size: 15, color: "#4a7ae8", orbit: 345, speed: 54, hasRing: false, line: "Deep blue... deep feelings 🧊💙" },
        { name: "Pluto",   size: 7,  color: "#c8a090", orbit: 385, speed: 60, hasRing: false, line: "Main chhota hoon... lekin exist karta hoon 🥺" }
    ];

    var solarSystem = document.getElementById("solarSystem");

    /* Orbit rings */
    planetsData.forEach(function (p) {
        var ring = document.createElement("div");
        ring.className = "orbit-ring";
        ring.style.width = (p.orbit * 2) + "px";
        ring.style.height = (p.orbit * 2) + "px";
        solarSystem.appendChild(ring);
    });

    /* Planet elements */
    planetsData.forEach(function (p) {
        var orbit = document.createElement("div");
        orbit.className = "planet-orbit";
        orbit.style.width = (p.orbit * 2) + "px";
        orbit.style.height = (p.orbit * 2) + "px";
        orbit.style.marginLeft = -p.orbit + "px";
        orbit.style.marginTop = -p.orbit + "px";
        orbit.style.animationDuration = p.speed + "s";

        var planet = document.createElement("div");
        planet.className = "planet";
        planet.style.width = p.size + "px";
        planet.style.height = p.size + "px";
        planet.style.background = "radial-gradient(circle at 35% 35%, " + lighten(p.color) + ", " + p.color + " 60%, " + darken(p.color) + " 100%)";
        planet.style.boxShadow = "0 0 " + (p.size) + "px " + p.color;
        planet.title = p.name;

        var eyeL = document.createElement("div");
        eyeL.className = "planet-eye left";
        var eyeR = document.createElement("div");
        eyeR.className = "planet-eye right";
        planet.appendChild(eyeL);
        planet.appendChild(eyeR);

        if (p.size >= 12) {
            var smile = document.createElement("div");
            smile.className = "planet-smile";
            planet.appendChild(smile);
        }

        if (p.hasRing) {
            var ringEl = document.createElement("div");
            ringEl.className = "saturn-rings";
            planet.appendChild(ringEl);
        }

        planet.style.left = p.orbit + "px";
        planet.style.top = p.orbit + "px";

        planet.addEventListener("mouseenter", function () {
            var bubble = document.getElementById("sunBubble");
            if (bubble) bubble.textContent = p.line;
        });

        orbit.appendChild(planet);
        solarSystem.appendChild(orbit);
    });

    function lighten(hex) {
        return "#" + hex.replace("#", "").split("").map(function (c) {
            var v = parseInt(c, 16);
            v = Math.min(15, v + 5);
            return v.toString(16);
        }).join("");
    }

    function darken(hex) {
        return "#" + hex.replace("#", "").split("").map(function (c) {
            var v = parseInt(c, 16);
            v = Math.max(0, v - 5);
            return v.toString(16);
        }).join("");
    }

    /* ─── NAME INPUT ─── */
    var input = document.getElementById("visitorName");
    var bubble = document.getElementById("sunBubble");

    if (input && bubble) {
        input.addEventListener("input", function () {
            var name = input.value.trim();
            if (name.length > 0) {
                bubble.textContent = "Wah, " + name + "! Kya khoobsurat naam hai! 💫 Tyaar ho apni cosmic journey ke liye?";
            } else {
                bubble.textContent = "✨ Ruk jao traveler! Pehle apna naam batao — phir hum sab tumhe apni duniya ghumayenge! 🌞";
            }
        });
    }

    /* ─── ENTER BUTTON ─── */
    var enterBtn = document.getElementById("enterBtn");

    if (enterBtn) {
        enterBtn.addEventListener("click", function () {
            var name = input ? input.value.trim() : "";

            if (!name) {
                if (bubble) bubble.textContent = "⚠️ Arre! Naam ke bina cosmos mein entry nahi milti! 😄";
                if (input) input.focus();
                return;
            }

            try {
                sessionStorage.setItem("visitorName", name);
                sessionStorage.setItem("welcomeDone", "1");
            } catch (e) {}

            if (bubble) bubble.textContent = "✨ Welcome " + name + "! Chalo apni duniya dekhte hain! 💜";

            var ws = document.getElementById("welcome-screen");
            if (ws) {
                setTimeout(function () {
                    ws.style.transition = "opacity 0.9s ease, transform 0.9s ease, filter 0.9s ease";
                    ws.style.opacity = "0";
                    ws.style.transform = "scale(1.15)";
                    ws.style.filter = "blur(8px)";

                    setTimeout(function () {
                        ws.style.display = "none";
                        document.body.classList.add("home-reveal");
                        /* Redirect to index.html */
                        window.location.href = "index.html";
                    }, 900);
                }, 700);
            }
        });
    }

    /* ─── MAGIC TYPING EFFECT ─── */
    var display = document.getElementById("liveNameDisplay");
    var wrap = document.querySelector(".wd-name-wrap");
    var canvas = document.getElementById("typeSparkleCanvas");

    if (!input || !display || !canvas) return;

    var ctx = canvas.getContext("2d");
    var dpr = window.devicePixelRatio || 1;

    function resizeCanvas() {
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        canvas.style.width = window.innerWidth + "px";
        canvas.style.height = window.innerHeight + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resizeCanvas();
    window.addEventListener("resize", resizeCanvas);

    var sparkles = [];

    function addSparkle(x, y) {
        var colors = ["#ffffff", "#ffc8f2", "#c9a6ff", "#ffe27a", "#67e8f9"];
        for (var i = 0; i < 12; i++) {
            sparkles.push({
                x: x, y: y,
                vx: (Math.random() - 0.5) * 8,
                vy: (Math.random() - 0.5) * 8 - 2,
                size: 2 + Math.random() * 4,
                life: 1,
                decay: 0.02 + Math.random() * 0.02,
                color: colors[Math.floor(Math.random() * colors.length)],
                gravity: 0.15,
                glow: 8 + Math.random() * 8
            });
        }
    }

    function drawSparkles() {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        for (var i = sparkles.length - 1; i >= 0; i--) {
            var s = sparkles[i];
            s.x += s.vx; s.y += s.vy; s.vy += s.gravity; s.vx *= 0.98; s.life -= s.decay;
            if (s.life <= 0) { sparkles.splice(i, 1); continue; }
            ctx.save();
            ctx.globalAlpha = s.life;
            ctx.fillStyle = s.color;
            ctx.shadowBlur = s.glow;
            ctx.shadowColor = s.color;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.size * s.life, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }
        requestAnimationFrame(drawSparkles);
    }
    drawSparkles();

    var emojis = ["✨", "💜", "⭐", "🌸", "💫", "🦋", "🌟", "💖", "🎀", "🪐"];

    function popEmoji(x, y) {
        var span = document.createElement("span");
        span.className = "type-particle";
        span.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        span.style.left = x + "px";
        span.style.top = y + "px";
        span.style.fontSize = (16 + Math.random() * 16) + "px";
        span.style.setProperty("--tx", ((Math.random() - 0.5) * 200) + "px");
        span.style.setProperty("--ty", (-80 - Math.random() * 120) + "px");
        span.addEventListener("animationend", function () { this.remove(); });
        document.body.appendChild(span);
    }

    function screenFlash() {
        var flash = document.createElement("div");
        flash.className = "type-flash";
        flash.addEventListener("animationend", function () { this.remove(); });
        document.body.appendChild(flash);
    }

    function updateLiveName(name) {
        display.textContent = "";
        if (!name) { display.classList.remove("visible"); return; }
        display.classList.add("visible");
        for (var i = 0; i < name.length; i++) {
            var letter = document.createElement("span");
            letter.className = "live-letter";
            letter.textContent = name[i] === " " ? "\u00A0" : name[i];
            letter.style.animationDelay = (i * 0.04) + "s";
            display.appendChild(letter);
        }
    }

    var lastLength = 0;

    input.addEventListener("input", function () {
        var val = input.value;
        var len = val.length;
        updateLiveName(val);
        if (len > lastLength && wrap) {
            var rect = input.getBoundingClientRect();
            var cx = rect.left + rect.width / 2;
            var cy = rect.top + rect.height / 2;
            addSparkle(cx, cy);
            popEmoji(cx, cy);
            screenFlash();
            wrap.classList.remove("typing", "shake-letter");
            void wrap.offsetWidth;
            wrap.classList.add("typing", "shake-letter");
            setTimeout(function () { wrap.classList.remove("shake-letter"); }, 220);
        }
        lastLength = len;
    });

})();
</script>
</body>
</html>
